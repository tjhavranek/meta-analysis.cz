# The top-level doi must match the version this file declares. It was the concept DOI,
# which always resolves to the newest release, so CFF tooling produced a citation reading
# "Version 1.1.1" that pointed wherever 1.2.0 will later live. The concept DOI stays below,
# labelled, and the README still recommends it for prose citation.
doi: "10.5281/zenodo.22050272"
version: "1.1.1"
date-released: "2026-08-21"
identifiers:
  - type: doi
    value: "10.5281/zenodo.21773678"
    description: "Concept DOI - always resolves to the latest version. Cite this."
  - type: doi
    value: "10.5281/zenodo.21789702"
    description: "Version 1.0.0 specifically, superseded by 1.1.1."
  - type: doi
    value: "10.5281/zenodo.22050272"
    description: "Version 1.1.1 specifically. Cite this in a replication package, where the exact files matter."
  - type: doi
    value: "10.5281/zenodo.21773679"
