#!/usr/bin/env bash
# Pre-push guardrail for meta-analysis.cz
#
# Why this exists: the seo-build-deploy workflow regenerates the invisible
# metadata layer and then VERIFIES it. The verify step runs BEFORE the deploy
# step, so when verify fails the site does not deploy at all -- the push looks
# fine locally, the run goes red, and the new page silently 404s.
#
# This hook runs exactly what CI runs, before the push leaves the machine.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:    git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

PY=$(command -v python || command -v python3) || { echo "pre-push: python not found; skipping checks"; exit 0; }
[ -f tools/generate_seo.py ] || exit 0   # not the site repo layout; nothing to check

fail() { echo ""; echo "PUSH BLOCKED: $1"; echo ""; exit 1; }

# The generator both writes the page blocks and enriches tools/papers.json from
# the pages, so a first run can leave input for a second. Iterate to a fixed
# point (it is idempotent) so the author has one set of files to commit, not two.
echo "pre-push: regenerating the metadata layer (same as CI)..."
for i in 1 2 3; do
  if ! "$PY" tools/generate_seo.py > /tmp/_seo_gen.log 2>&1; then
    sed -n '1,40p' /tmp/_seo_gen.log
    fail "tools/generate_seo.py failed.
  Usually this means a project folder has no entry in tools/papers.json.
  Every folder with an index.html needs one (project, title, abstract,
  authors, year) or Google Scholar tags cannot be generated and CI goes red."
  fi
  snapshot=$(git status --porcelain -- . | sha1sum)
  [ "${prev_snapshot:-}" = "$snapshot" ] && break
  prev_snapshot="$snapshot"
done
sed -n '1,12p' /tmp/_seo_gen.log

if [ -f komentare/build.py ]; then
  echo "pre-push: checking the self-managed commentary section..."
  "$PY" komentare/build.py --check > /tmp/_seo_kom.log 2>&1 || { sed -n '1,30p' /tmp/_seo_kom.log; fail "komentare/build.py --check failed."; }
fi

# The data layer's own gate. It checks things verify_seo cannot see: duplicate literatures,
# unit violations, implausible sample sizes, direction notes that contradict their data,
# advertised URLs, parquet/csv agreement. It was never wired in, so the strongest verifier
# in the repo ran only when someone remembered. Only for changes that touch the data layer,
# and skipped cleanly if its dependencies are absent (CI has no pandas).
# What is actually being pushed. At pre-push time the work is already COMMITTED, so
# "git diff HEAD" and "git diff --cached HEAD" are both empty and this gate never fired.
# That is exactly how the .zenodo.json drift in 01b3bbb0 reached CI: the commit changed
# data_layer/zenodo.json, the condition saw nothing, and the run went red. Compare against
# the upstream branch instead, keeping the working-tree checks as a fallback for the case
# where this is run with changes still uncommitted.
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)
PUSHING=$( { git diff --name-only "$UPSTREAM...HEAD" 2>/dev/null
             git diff --name-only HEAD 2>/dev/null
             git diff --cached --name-only HEAD 2>/dev/null; } | sort -u )

if printf '%s\n' "$PUSHING" | grep -qE '^(data_layer/|api/|data/|CITATION\.cff|\.zenodo\.json|LICENSE)'; then
  if [ -f data_layer/09_verify.py ] && "$PY" -c "import pandas, pyarrow" >/dev/null 2>&1; then
    echo "pre-push: running the data-layer gate (09_verify.py)..."
    if ! "$PY" data_layer/09_verify.py > /tmp/_dl_verify.log 2>&1; then
      sed -n '/FAILURE/,$p' /tmp/_dl_verify.log | head -20
      fail "data_layer/09_verify.py failed. The data layer is inconsistent with its own
  metadata. Fix it before publishing -- this gate exists because several defects
  (duplicate literatures, a units error of 100x, a sample size stored as a log)
  passed every other check."
    fi
    tail -1 /tmp/_dl_verify.log
  else
    echo "pre-push: data-layer gate skipped (pandas/pyarrow not available)"
  fi

  # CI runs "rebuild.py --check --data" and fails on ANY drift between the published
  # files and what the inputs produce. Regenerate here instead of running its --check:
  # that check compares raw bytes and reports ~46 false positives on a Windows checkout
  # (CRLF) which Linux CI never sees. Rebuilding lets real drift surface as an ordinary
  # git diff, which is line-ending aware, and the "must be committed" test at the end of
  # this hook then blocks the push.
  if [ -f data_layer/rebuild.py ] && "$PY" -c "import pandas, pyarrow" >/dev/null 2>&1; then
    echo "pre-push: rebuilding the data layer (same as CI)..."
    if ! "$PY" data_layer/rebuild.py --data > /tmp/_dl_rebuild.log 2>&1; then
      sed -n '1,30p' /tmp/_dl_rebuild.log
      fail "data_layer/rebuild.py failed; the data layer cannot be rebuilt from its inputs."
    fi
  fi
fi

echo "pre-push: verifying..."
if ! "$PY" tools/verify_seo.py > /tmp/_seo_ver.log 2>&1; then
  sed -n '1,40p' /tmp/_seo_ver.log
  fail "tools/verify_seo.py failed -- CI would go red and THE SITE WOULD NOT DEPLOY.
  Most common causes when adding a page:
    * hand-written <meta property=\"og:...\"> / citation_* / ld+json in the page.
      Those belong ONLY inside the <!-- seo-meta:start --> block, which the
      generator writes. Delete them from your page and let the generator emit them.
    * a linked local PDF with no citation_pdf_url -> add the paper to tools/papers.json.
    * hand-edited JSON-LD on the homepage -- that block is generator-owned too."
fi
tail -2 /tmp/_seo_ver.log

# The pushed state must match what CI will verify, so generated output must be committed.
if ! git diff --quiet -- . ; then
  echo ""
  echo "Files the generator rewrote but which are not committed:"
  git diff --name-only -- . | sed 's/^/    /' | head -20
  fail "the metadata layer changed. Commit these files, then push again,
  so the pushed tree matches what CI regenerates and verifies."
fi

echo "pre-push: OK (metadata generated, verified, and committed)"
exit 0
