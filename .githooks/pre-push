#!/usr/bin/env bash
# Pre-push guardrail for meta-analysis.cz
#
# Why this exists: the seo-build-deploy workflow regenerates the invisible
# metadata layer and then VERIFIES it. The verify step runs BEFORE the deploy
# step, so when verify fails the site does not deploy at all -- the push looks
# fine locally, the run goes red, and the new page silently 404s.
#
# This hook runs exactly what CI runs, before the push leaves the machine.
#
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:    git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

PY=$(command -v python || command -v python3) || { echo "pre-push: python not found; skipping checks"; exit 0; }
[ -f tools/generate_seo.py ] || exit 0   # not the site repo layout; nothing to check

# CI runs on Linux, where Python reads and writes UTF-8 by default. On a Windows
# checkout the default is cp1252, and three of the checks below die decoding a page
# that CI reads without complaint. UTF-8 mode removes that whole class of
# environment-only difference; on Linux it changes nothing.
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

fail() { echo ""; echo "PUSH BLOCKED: $1"; echo ""; exit 1; }

# Run one of CI's verifiers and stop the push if it fails. Skipped cleanly when the
# script is absent, so this hook keeps working if the repo layout changes.
run_check() {  # run_check <label> <script> [args...]
  label=$1; shift
  [ -f "$1" ] || return 0
  echo "pre-push: $label"
  if ! "$PY" "$@" > /tmp/_seo_step.log 2>&1; then
    sed -n '1,25p' /tmp/_seo_step.log
    fail "$* failed. CI runs exactly this and would go red, and the site would not deploy."
  fi
}

# CI's first step. Catches a syntax error before anything slower runs. Called directly
# rather than through run_check, whose "is it a file" guard would see "-m" and skip.
echo "pre-push: syntax-checking the tools..."
if ! "$PY" -m py_compile tools/generate_seo.py tools/verify_seo.py komentare/build.py > /tmp/_seo_step.log 2>&1; then
  sed -n '1,25p' /tmp/_seo_step.log
  fail "a tool does not compile. CI runs this first and would go red."
fi

# Size. Pages publishes the whole checkout and GitHub gives no timely warning near its 1 GB
# limit, so a push that adds more than 10 MB, or takes the site past 900 MB, stops here with a
# report of what grew. It runs before the slow checks because it takes a second, and a large
# addition deserves a look before anything else. When the growth is intended: SIZE_OK=1 git push
if [ -f tools/check_site_size.py ]; then
  echo "pre-push: checking the site size..."
  SIZE_BASE=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)
  if ! "$PY" tools/check_site_size.py "$SIZE_BASE" > /tmp/_size.log 2>&1; then
    cat /tmp/_size.log
    fail "the push makes the site much larger (see above). Look at what grew before publishing.
  If the growth is intended, push again with SIZE_OK=1."
  fi
  cat /tmp/_size.log
fi

# This hook is the one battery a push runs (5 Oct 2026: running tools/preflight.py first and
# then this hook repeated every gate, about 20 minutes a push). So it must not miss a gate CI
# has: stop if a script the workflow runs is not named here.
if ! "$PY" - > /tmp/_gates.log 2>&1 <<'PYEOF'
import re, sys
sys.path.insert(0, "tools")
import preflight
cmds, unknown = preflight.ci_commands()
code = " ".join(l for l in open(".githooks/pre-push", encoding="utf-8").read().splitlines()
                if not l.lstrip().startswith("#"))
code = re.sub(r"\s+", " ", code)
# The one deliberate local difference: the data layer is regenerated rather than --checked
# here, because --check compares raw bytes and a Windows checkout reports CRLF drift.
EQUIV = {"data_layer/rebuild.py --check --data": "data_layer/rebuild.py --data"}
missing = []
for c in cmds:
    m = re.search(r"(?:-m \S+ )?[\w./-]+\.py.*$", c)
    want = re.sub(r"\s+", " ", m.group(0).strip()) if m else c
    want = EQUIV.get(want, want)
    if want not in code:
        missing.append(want)
if missing or unknown:
    print("CI runs these, the hook does not:", "; ".join(missing + unknown))
    sys.exit(1)
PYEOF
then
  cat /tmp/_gates.log
  fail "the hook has fallen behind the workflow. Add the gate(s) above to .githooks/pre-push."
fi

# What is actually being pushed. At pre-push time the work is already COMMITTED, so
# "git diff HEAD" and "git diff --cached HEAD" are both empty; compare against the upstream
# branch, keeping the working-tree checks for a run with changes still uncommitted.
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)
PUSHING=$( { git diff --name-only "$UPSTREAM...HEAD" 2>/dev/null
             git diff --name-only HEAD 2>/dev/null
             git diff --cached --name-only HEAD 2>/dev/null; } | sort -u )

# A push that touches only the commentary section (komentare/) or the pages of /ai/ cannot
# change what the full-text and data gates read: no catalogue in tools/ names those folders
# and the data inventory skips komentare (data_layer/98_catalogue_complete.py, SKIP_DIRS).
# The two generated files such a push usually carries, sitemap.xml and the site search index
# api/v1/search-index.json, are read by none of those gates either (8 of the last 15
# komentare commits carried the index); generate_seo, verify_seo and the index check still run.
# Such a push skips those gates here, about eight of the ten minutes; CI still runs all of
# them. Anything else, a tool, this hook or the workflow included, runs everything.
# Force the full battery with FULL=1 git push.
# Light mode also needs a base CI has passed: after a red run, a light push would skip the
# very gates that failed and CI would fail again (Astra). grep -c reads all its input; a
# grep -q that exits early can SIGPIPE printf, and under pipefail flip the test.
LIGHT_ONLY=0
NONLIGHT=$(printf '%s\n' "$PUSHING" | grep -cvE '^(komentare/|ai/[^/]+\.(html|md|css|js)$|sitemap\.xml$|api/v1/search-index\.json$)')
if [ -n "$PUSHING" ] && [ "${FULL:-0}" != "1" ] && [ "$NONLIGHT" = 0 ]; then
  BASE_SHA=$(git rev-parse "$UPSTREAM" 2>/dev/null)
  BASE_OK=$(gh run list -R tjhavranek/meta-analysis.cz --workflow seo.yml --commit "$BASE_SHA" \
            --json conclusion --jq '[.[] | select(.conclusion == "success")] | length' 2>/dev/null)
  if [ "${BASE_OK:-0}" -ge 1 ] 2>/dev/null; then
    LIGHT_ONLY=1
    echo "pre-push: only komentare/ or /ai/ pages are pushed and CI passed on the base: the full-text and data gates are skipped here (CI runs them)"
  else
    echo "pre-push: no green CI run found for the base ${BASE_SHA:0:8}: running every gate"
  fi
fi

# The generator both writes the page blocks and enriches tools/papers.json from
# the pages, so a first run can leave input for a second. Iterate to a fixed
# point (it is idempotent) so the author has one set of files to commit, not two.
# The tree before the first run is the first comparison, so a run that changes nothing
# stops at once instead of running the generator a second time (47 s).
echo "pre-push: regenerating the metadata layer (same as CI)..."
prev_snapshot=$(git -c core.safecrlf=false status --porcelain -- . 2>/dev/null | sha1sum)
for i in 1 2 3; do
  if ! "$PY" tools/generate_seo.py > /tmp/_seo_gen.log 2>&1; then
    sed -n '1,40p' /tmp/_seo_gen.log
    fail "tools/generate_seo.py failed.
  Usually this means a project folder has no entry in tools/papers.json.
  Every folder with an index.html needs one (project, title, abstract,
  authors, year) or Google Scholar tags cannot be generated and CI goes red."
  fi
  snapshot=$(git -c core.safecrlf=false status --porcelain -- . 2>/dev/null | sha1sum)
  [ "${prev_snapshot:-}" = "$snapshot" ] && break
  prev_snapshot="$snapshot"
done
sed -n '1,12p' /tmp/_seo_gen.log

if [ -f komentare/build.py ] && { [ "$LIGHT_ONLY" != 1 ] || [ "$(printf '%s\n' "$PUSHING" | grep -c '^komentare/')" != 0 ]; }; then
  echo "pre-push: checking the self-managed commentary section..."
  "$PY" komentare/build.py --check > /tmp/_seo_kom.log 2>&1 || { sed -n '1,30p' /tmp/_seo_kom.log; fail "komentare/build.py --check failed."; }
fi

# The data layer's own gate. It checks things verify_seo cannot see: duplicate literatures,
# unit violations, implausible sample sizes, direction notes that contradict their data,
# advertised URLs, parquet/csv agreement. It was never wired in, so the strongest verifier
# in the repo ran only when someone remembered. Only for changes that touch the data layer,
# and skipped cleanly if its dependencies are absent (CI has no pandas).
# PUSHING (above) compares against the upstream branch: comparing against HEAD saw nothing,
# which is how the .zenodo.json drift in 01b3bbb0 reached CI and the run went red.
# CI runs these gates on every push, and they read tools/papers.json and the project pages
# too, so since this hook became the only battery (5 Oct 2026) they run on every push that
# is not komentare- or /ai/-only, not just on data changes.
if [ "$LIGHT_ONLY" != 1 ]; then
  if [ -f data_layer/09_verify.py ] && ! "$PY" -c "import pandas, pyarrow" >/dev/null 2>&1; then
    fail "pandas/pyarrow are missing, so the data gates CI runs cannot run here.
  Install them: python -m pip install -r data_layer/requirements-pinned.txt"
  fi
  if [ -f data_layer/09_verify.py ]; then
    echo "pre-push: running the data-layer gate (09_verify.py)..."
    if ! "$PY" data_layer/09_verify.py > /tmp/_dl_verify.log 2>&1; then
      sed -n '/FAILURE/,$p' /tmp/_dl_verify.log | head -20
      fail "data_layer/09_verify.py failed. The data layer is inconsistent with its own
  metadata. Fix it before publishing -- this gate exists because several defects
  (duplicate literatures, a units error of 100x, a sample size stored as a log)
  passed every other check."
    fi
    tail -1 /tmp/_dl_verify.log
  fi

  # CI runs "rebuild.py --check --data" and fails on ANY drift between the published
  # files and what the inputs produce. Regenerate here instead of running its --check:
  # that check compares raw bytes and reports ~46 false positives on a Windows checkout
  # (CRLF) which Linux CI never sees. Rebuilding lets real drift surface as an ordinary
  # git diff, which is line-ending aware, and the "must be committed" test at the end of
  # this hook then blocks the push.
  if [ -f data_layer/rebuild.py ] && "$PY" -c "import pandas, pyarrow" >/dev/null 2>&1; then
    echo "pre-push: rebuilding the data layer (same as CI)..."
    if ! "$PY" data_layer/rebuild.py --data > /tmp/_dl_rebuild.log 2>&1; then
      sed -n '1,30p' /tmp/_dl_rebuild.log
      fail "data_layer/rebuild.py failed; the data layer cannot be rebuilt from its inputs."
    fi
  fi
fi

# The site builders' own verifiers. CI runs all of these and any one of them turns the
# run red, but the hook never ran a single one -- which is why red runs kept arriving
# from pushes that passed every local check. They need the pinned latex2mathml; if it is
# missing the hook says so rather than pretending the tree was checked.
if "$PY" -c "import latex2mathml" >/dev/null 2>&1; then
  run_check "verifying the headline evidence..."            tools/check_evidence.py
  run_check "verifying the matched reference DOIs..."       tools/check_reference_dois.py
  run_check "checking the search index against the pages..." tools/build_search_index.py --check
  run_check "checking counts written in prose..."            tools/check_counts.py
  run_check "verifying the MAIVE how-to..."                 tools/check_maive_howto.py
  run_check "checking api/v1/papers.json..."                tools/build_papers_api.py --check
  run_check "checking the publication lists..."             tools/build_publications_page.py --check
  run_check "checking /papers/..."                          tools/build_fulltext_page.py --check

  # The full-text gates read the catalogue, the transcripts, the paper pages and the PDFs,
  # none of which a komentare- or /ai/-only push can change (see LIGHT_ONLY above).
  if [ "$LIGHT_ONLY" = 1 ]; then
    echo "pre-push: full-text gates skipped (komentare/ or /ai/ pages only; CI runs them)"
  else
  run_check "checking the full-text pages against their transcripts..." tools/build_paper_page.py --all --check
  run_check "auditing transcript continuity..."             tools/audit_continuity.py

  # The full-text gate reads the PDFs. CI installs poppler-utils; a Windows checkout
  # usually finds Xpdf's pdftotext first on PATH instead, which returns a different text
  # layer and reports failures that do not exist in CI. The tools no longer take PATH's
  # word for it: tools/_poppler.py resolves a real poppler build wherever it lives (MiKTeX
  # ships one), so ask the resolver rather than PATH, and skip only when it finds none.
  if [ -f tools/check_paper_pages.py ]; then
    if "$PY" -c "import sys; sys.path.insert(0, 'tools'); import _poppler; sys.exit(0 if _poppler.is_poppler(_poppler.tool('pdftotext')) else 1)" >/dev/null 2>&1; then
      run_check "verifying the full-text pages (slow)..."   tools/check_paper_pages.py
      run_check "checking numbers in transcribed tables..." tools/check_table_numbers.py
      run_check "testing the table-number checker..."       tools/test_check_table_numbers.py
    else
      echo "pre-push: full-text page check SKIPPED (needs poppler's pdftotext; this machine has $(pdftotext -v 2>&1 | head -1 | cut -c1-40))"
    fi
  fi
  fi
else
  fail "latex2mathml is missing, so the site-builder gates CI runs cannot run here.
  Install it: python -m pip install -r tools/requirements-pinned.txt"
fi

echo "pre-push: verifying..."
if ! "$PY" tools/verify_seo.py > /tmp/_seo_ver.log 2>&1; then
  sed -n '1,40p' /tmp/_seo_ver.log
  fail "tools/verify_seo.py failed -- CI would go red and THE SITE WOULD NOT DEPLOY.
  Most common causes when adding a page:
    * hand-written <meta property=\"og:...\"> / citation_* / ld+json in the page.
      Those belong ONLY inside the <!-- seo-meta:start --> block, which the
      generator writes. Delete them from your page and let the generator emit them.
    * a linked local PDF with no citation_pdf_url -> add the paper to tools/papers.json.
    * hand-edited JSON-LD on the homepage -- that block is generator-owned too."
fi
tail -2 /tmp/_seo_ver.log

# The pushed state must match what CI will verify, so generated output must be committed.
if ! git -c core.safecrlf=false diff --quiet -- . 2>/dev/null; then
  echo ""
  echo "Files the generator rewrote but which are not committed:"
  git -c core.safecrlf=false diff --name-only -- . 2>/dev/null | sed 's/^/    /' | head -20
  fail "the metadata layer changed. Commit these files, then push again,
  so the pushed tree matches what CI regenerates and verifies."
fi

# Staged but uncommitted changes passed the check above (it compares the working tree with the
# index), yet they are not what is pushed, so the tree just verified is not the one CI gets.
if ! git -c core.safecrlf=false diff --cached --quiet HEAD -- . 2>/dev/null; then
  echo ""
  git -c core.safecrlf=false diff --cached --name-only HEAD -- . 2>/dev/null | sed 's/^/    /' | head -20
  fail "these changes are staged but not committed. Commit them (or unstage them), then push again."
fi

echo "pre-push: OK (metadata generated, verified, and already committed)"
exit 0
